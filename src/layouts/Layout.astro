---
import UgandanFlagStripe from '../components/UgandanFlagStripe.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title = "Batenga Community Foundation", activePage } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content="Batenga Community Foundation is a grassroots non-profit in Uganda. We build dignity, support housing projects, youth development, and support vulnerable communities since 2015." />
  
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  
  <!-- Swiper Bundle (if needed on page, but we can load CDN globally or import it locally on home) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="bg-[#0A0A0A] text-[#F8F5F0] font-sans antialiased overflow-x-hidden m-0 p-0">
  <UgandanFlagStripe />
  
  <Navbar activePage={activePage} />
  
  <slot />
  
  <Footer />
</body>
</html>
