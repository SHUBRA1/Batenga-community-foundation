---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — Batenga Community Foundation">
  <main class="min-h-[80vh] pt-28 pb-12 flex flex-col items-center justify-center text-center px-4 relative overflow-hidden">
    <!-- Background glow/blobs for rich aesthetics -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[#2A8B3C]/5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-[#F4C400]/5 blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 max-w-lg mx-auto animate-fade-up">
      <!-- Icon/Illustration -->
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#2A8B3C]/10 text-[#38A84F] text-3xl mb-8 border border-[#2A8B3C]/20 shadow-lg shadow-[#2A8B3C]/5">
        <i class="fas fa-triangle-exclamation"></i>
      </div>

      <!-- Main Heading -->
      <h1 class="font-serif text-6xl md:text-8xl font-black text-white tracking-tight mb-4">404</h1>
      <h2 class="font-serif text-xl md:text-2xl font-bold text-white mb-6">Page Not Found</h2>
      
      <div class="w-12 h-1 bg-[#2A8B3C] mx-auto mb-6"></div>

      <!-- Description -->
      <p class="text-white/60 text-sm md:text-base leading-relaxed mb-10">
        We can't seem to find the page you're looking for. It might have been moved, deleted, or the link may be broken.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/" class="w-full sm:w-auto bg-[#2A8B3C] text-[#F8F5F0] hover:bg-[#38A84F] hover:-translate-y-[2px] transition-all px-8 py-3 rounded-[3px] text-xs font-bold tracking-[0.08em] uppercase no-underline shadow-lg shadow-[#2A8B3C]/15">
          Go Back Home
        </a>
        <a href="/programs" class="w-full sm:w-auto border border-white/20 text-white hover:border-[#38A84F] hover:text-[#38A84F] hover:-translate-y-[2px] transition-all px-8 py-3 rounded-[3px] text-xs font-bold tracking-[0.08em] uppercase no-underline backdrop-blur-sm">
          Our Programs
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>
