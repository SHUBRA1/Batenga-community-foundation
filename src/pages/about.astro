---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us — Batenga Community Foundation" activePage="about">
  <main class="max-w-[1080px] mx-auto mt-28 px-4 pb-20">
    <!-- Hero Page Header -->
    <header class="text-center mb-16 animate-fade-up">
      <span class="text-[#38A84F] uppercase font-bold tracking-[0.2em] text-xs">Our Story</span>
      <h1 class="font-serif text-3xl md:text-5xl font-black mt-3 text-white leading-tight">About Batenga Foundation</h1>
      <div class="w-16 h-1 bg-[#2A8B3C] mx-auto mt-6 mb-6"></div>
      <p class="text-white/70 max-w-[760px] mx-auto text-sm md:text-base leading-relaxed">
        Restoring dignity and rebuilding hope for widows, orphans, and vulnerable families across Uganda since 2015.
      </p>
    </header>

    <!-- Two-Column Who We Are Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-20 reveal">
      <div>
        <h2 class="font-serif font-black text-2xl md:text-3.5xl text-white mb-6">Who We Are</h2>
        <p class="text-white/70 text-sm md:text-base leading-relaxed mb-4">
          Batenga Community Foundation is a grassroots non-governmental organization dedicated to empowering and uplifting vulnerable groups in Uganda. Founded in 2015, we began our work by identifying the critical challenges faced by widows and orphans in rural districts.
        </p>
        <p class="text-white/70 text-sm md:text-base leading-relaxed mb-6">
          Rather than offering short-term relief, we focus on establishing foundations of safety and independence. This is reflected in our major initiatives—such as constructing sturdy, permanent housing for widows and providing educational sponsorships for orphaned children.
        </p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#2A8B3C]/10 flex items-center justify-center text-[#38A84F]">
            <i class="fas fa-location-dot"></i>
          </div>
          <div>
            <span class="text-white font-semibold text-xs md:text-sm block">Headquarters:</span>
            <span class="text-white/60 text-xs">Nansana East II, Wakiso District, Uganda</span>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-tr from-[#2A8B3C] to-[#F4C400] rounded-md blur opacity-20"></div>
        <div class="relative bg-[#111] border border-white/5 p-8 md:p-10 rounded-md shadow-xl">
          <h3 class="font-serif font-bold text-lg text-[#F4C400] mb-4 flex items-center gap-2">
            <i class="fas fa-shield-halved"></i> Registration & Compliance
          </h3>
          <p class="text-white/70 text-xs md:text-sm leading-relaxed mb-6">
            Batenga Community Foundation is incorporated with the Uganda Registration Services Bureau (URSB) as a Company Limited by Guarantee, ensuring strict regulatory standards, operational accountability, and transparency.
          </p>
          <div class="bg-black/35 border border-white/5 rounded p-4 flex flex-col gap-2">
            <div class="flex justify-between text-xs"><span class="text-white/40">Registration No:</span> <strong class="text-white">80034651950097</strong></div>
            <div class="flex justify-between text-xs"><span class="text-white/40">Incorporation Year:</span> <strong class="text-white">2015</strong></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision & Mission Cards -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20 reveal">
      <div class="bg-[#111] border border-white/5 hover:border-[#2A8B3C]/30 rounded-md p-8 transition-all duration-300">
        <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
          <i class="fas fa-eye text-[#38A84F] text-xl"></i>
        </div>
        <h3 class="font-serif font-bold text-xl text-white mb-4">Our Vision</h3>
        <p class="text-white/75 text-sm leading-relaxed">
          A world where every citizen possesses the knowledge, skills, and civic competencies to contribute to the creation and maintenance of balanced, supportive, and compatible societies.
        </p>
      </div>

      <div class="bg-[#111] border border-white/5 hover:border-[#2A8B3C]/30 rounded-md p-8 transition-all duration-300">
        <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
          <i class="fas fa-bullseye text-[#38A84F] text-xl"></i>
        </div>
        <h3 class="font-serif font-bold text-xl text-white mb-4">Our Mission</h3>
        <p class="text-white/75 text-sm leading-relaxed">
          To equip citizens with tools, methodologies, and knowledge that enhance civic competence and promote best practices at the individual, community, and governmental levels, fostering self-reliance.
        </p>
      </div>
    </section>

    <!-- Our Values Section (Premium Addition) -->
    <section class="border-t border-white/5 pt-16 reveal">
      <div class="text-center mb-12">
        <span class="text-[#38A84F] uppercase font-bold tracking-[0.2em] text-xs">Our Core Values</span>
        <h2 class="font-serif text-2xl md:text-3.5xl font-black mt-2 text-white">The Pillars of Our Foundation</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-black/30 border border-white/5 rounded p-6 text-center">
          <i class="fas fa-heart text-[#C8102E] text-2xl mb-4"></i>
          <h4 class="font-bold text-[#F8F5F0] text-sm mb-2 uppercase tracking-wider">Compassion</h4>
          <p class="text-white/50 text-xs leading-relaxed">Serving the underserved with deep empathy and active kindness.</p>
        </div>
        <div class="bg-black/30 border border-white/5 rounded p-6 text-center">
          <i class="fas fa-handshake text-[#F4C400] text-2xl mb-4"></i>
          <h4 class="font-bold text-[#F8F5F0] text-sm mb-2 uppercase tracking-wider">Integrity</h4>
          <p class="text-white/50 text-xs leading-relaxed">Maintaining full transparency and accountability in all projects.</p>
        </div>
        <div class="bg-black/30 border border-white/5 rounded p-6 text-center">
          <i class="fas fa-scale-balanced text-[#38A84F] text-2xl mb-4"></i>
          <h4 class="font-bold text-[#F8F5F0] text-sm mb-2 uppercase tracking-wider">Dignity</h4>
          <p class="text-white/50 text-xs leading-relaxed">Restoring self-respect through sustainable, long-term support.</p>
        </div>
        <div class="bg-black/30 border border-white/5 rounded p-6 text-center">
          <i class="fas fa-users-viewfinder text-white/50 text-2xl mb-4"></i>
          <h4 class="font-bold text-[#F8F5F0] text-sm mb-2 uppercase tracking-wider">Community</h4>
          <p class="text-white/50 text-xs leading-relaxed">Collaborating closely with local leadership to build stability.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Reveal transition style */
  :global(.reveal) {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.reveal.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>

<script>
  // Simple intersection observer for reveals
  const revealEls = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  revealEls.forEach((el) => obs.observe(el));
</script>
