---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob('/src/assets/images/hero/*.{jpeg,jpg,png,gif}');
const videoModules = import.meta.glob('/src/assets/images/hero/*.mp4');

const images = await Promise.all(
  Object.keys(imageModules).map(async (path) => {
    const mod = await imageModules[path]();
    const filename = path.split('/').pop().replace(/\.[^/.]+$/, "");
    return {
      src: mod.default,
      alt: filename.replace('image', 'Photo '),
      id: filename,
      type: 'image'
    };
  })
);

const videos = await Promise.all(
  Object.keys(videoModules).map(async (path) => {
    const mod = await videoModules[path]();
    const filename = path.split('/').pop().replace(/\.[^/.]+$/, "");
    return {
      src: mod.default,
      alt: filename.replace('video', 'Video '),
      id: filename,
      type: 'video'
    };
  })
);

const allMedia = [...images, ...videos];
allMedia.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' }));
---

<Layout title="Gallery — Batenga Community Foundation" activePage="gallery">
  <main class="max-w-[1200px] mx-auto mt-28 px-4 pb-20">
    <!-- Hero Header -->
    <header class="text-center mb-12">
      <span class="text-[#38A84F] uppercase font-bold tracking-[0.2em] text-xs">Photo Gallery</span>
      <h1 class="font-serif text-3xl md:text-5xl font-black mt-3 text-white leading-tight">Snapshots of our work and community</h1>
      <div class="w-16 h-1 bg-[#2A8B3C] mx-auto mt-6 mb-6"></div>
      <p class="text-white/70 max-w-[760px] mx-auto text-sm md:text-base leading-relaxed">
        Batenga Community Foundation has been walking alongside Uganda's most vulnerable since 2015. These images show housing projects, outreach events, youth activities, and community moments that reflect the dignity and resilience of the people we serve.
      </p>
    </header>

    <!-- Programs Navigation Highlights Card -->
    <section class="bg-[#111] border border-white/5 rounded-md p-6 md:p-8 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 select-none">
      <div>
        <span class="text-[#F4C400] uppercase font-bold tracking-wider text-[10px] block mb-1">Programs & Achievements</span>
        <h2 class="font-serif text-lg md:text-xl font-bold text-white mb-2">Program Highlights & Impact</h2>
        <p class="text-white/60 text-xs md:text-sm max-w-[600px] leading-relaxed">
          For full program details and measured outcomes, visit our impact section on the home page.
        </p>
      </div>
      <div class="flex-shrink-0 w-full md:w-auto">
        <a href={`${import.meta.env.BASE_URL}#impact`} class="w-full md:w-auto text-center inline-block bg-[#2A8B3C] text-white hover:bg-[#38A84F] hover:-translate-y-[1px] transition-all px-6 py-3 rounded-[3px] text-xs font-bold tracking-wider uppercase no-underline shadow-lg shadow-[#2A8B3C]/10">
          View Impact on Home
        </a>
      </div>
    </section>

    <!-- Tabs -->
    <div class="flex justify-center gap-4 mb-8">
      <button id="tab-photos" class="tab-btn active px-6 py-2 rounded-md text-sm font-bold tracking-wider uppercase border border-white/10 bg-[#2A8B3C] text-white transition-all" data-tab="photos">
        Photos
      </button>
      <button id="tab-videos" class="tab-btn px-6 py-2 rounded-md text-sm font-bold tracking-wider uppercase border border-white/10 bg-transparent text-white/60 hover:text-white hover:border-white/20 transition-all" data-tab="videos">
        Videos
      </button>
    </div>

    <!-- Gallery Grid -->
    <section class="gallery">
      <div class="gallery-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4" id="galleryGrid">
        {allMedia.map((item, index) => (
          <figure 
            class={`gallery-item cursor-pointer relative overflow-hidden rounded-md border border-white/5 bg-[#0e0e0e] aspect-[4/3] group ${item.type === 'video' ? 'video-item' : ''}`}
            data-index={index}
            data-full-src={item.type === 'image' ? item.src.src : item.src}
            data-type={item.type}
            data-alt={item.alt}
          >
            {item.type === 'image' ? (
              <>
                <Image 
                  src={item.src} 
                  alt={item.alt} 
                  width={400} 
                  height={300}
                  quality="medium"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                />
                <figcaption class="absolute inset-0 bg-black/85 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-center items-center p-4 text-center">
                  <i class="fas fa-magnifying-glass-plus text-lg text-[#F4C400] mb-2 scale-90 group-hover:scale-100 transition-transform duration-300"></i>
                  <span class="text-white font-serif font-bold text-sm mb-1">{item.alt}</span>
                  <span class="text-white/60 text-[10px] tracking-wider uppercase">Click to Enlarge</span>
                </figcaption>
              </>
            ) : (
              <>
                <video 
                  src={item.src} 
                  preload="metadata" 
                  class="w-full h-full object-cover"
                  muted
                ></video>
                <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition-all">
                  <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center">
                    <i class="fas fa-play text-white text-lg ml-1"></i>
                  </div>
                </div>
                <figcaption class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-3 text-center">
                  <span class="text-white font-serif font-bold text-sm">{item.alt}</span>
                </figcaption>
              </>
            )}
          </figure>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <p class="text-xs text-white/40 leading-relaxed max-w-[640px]">
          Captions and program descriptions drawn from the main site content. For image credits or to contribute photos, please <a href="mailto:batengafoundation@gmail.com" class="underline hover:text-[#38A84F] transition-colors">contact us</a>.
        </p>
      </div>
    </section>
  </main>

  <!-- Premium Lightbox Overlay -->
  <div id="lightbox" class="hidden fixed inset-0 bg-black/95 backdrop-blur-md z-[1000] select-none opacity-0 transition-opacity duration-300">
    <div class="relative w-full h-full flex items-center justify-center p-4">
      <!-- Close Button -->
      <button id="lb-close" aria-label="Close" class="absolute top-5 right-6 bg-transparent border-0 text-white hover:text-[#38A84F] text-4xl cursor-pointer transition-colors z-50">
        &times;
      </button>
      
      <!-- Navigation Buttons -->
      <button id="lb-prev" aria-label="Previous" class="absolute left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full border border-white/10 bg-black/35 text-white hover:text-[#38A84F] hover:border-[#38A84F]/40 flex items-center justify-center cursor-pointer transition-all duration-200 z-50">
        <i class="fas fa-chevron-left text-lg"></i>
      </button>
      <button id="lb-next" aria-label="Next" class="absolute right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full border border-white/10 bg-black/35 text-white hover:text-[#38A84F] hover:border-[#38A84F]/40 flex items-center justify-center cursor-pointer transition-all duration-200 z-50">
        <i class="fas fa-chevron-right text-lg"></i>
      </button>
      
      <!-- Lightbox Content Container -->
      <div id="lb-content" class="max-w-[1080px] max-h-[85vh] flex flex-col items-center gap-4">
        <div class="relative overflow-hidden rounded-md border border-white/10 shadow-2xl bg-black">
          <img id="lb-image" src="" alt="" class="max-w-full max-h-[70vh] object-contain block transition-transform duration-300" />
          <video id="lb-video" src="" controls class="max-w-full max-h-[70vh] object-contain block hidden"></video>
        </div>
        <div id="lb-caption" class="font-serif text-white/90 text-sm md:text-base text-center max-w-[800px] px-4 font-semibold tracking-wide"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Tab switching
  const tabPhotos = document.getElementById('tab-photos');
  const tabVideos = document.getElementById('tab-videos');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const photoItems = document.querySelectorAll('.gallery-item[data-type="image"]');
  const videoItems = document.querySelectorAll('.gallery-item[data-type="video"]');
  
  function showTab(tab) {
    galleryItems.forEach(item => item.style.display = 'none');
    
    if (tab === 'photos') {
      photoItems.forEach(item => item.style.display = '');
      tabPhotos.classList.add('bg-[#2A8B3C]', 'text-white');
      tabPhotos.classList.remove('bg-transparent', 'text-white/60');
      tabVideos.classList.remove('bg-[#2A8B3C]', 'text-white');
      tabVideos.classList.add('bg-transparent', 'text-white/60');
    } else {
      videoItems.forEach(item => item.style.display = '');
      tabVideos.classList.add('bg-[#2A8B3C]', 'text-white');
      tabVideos.classList.remove('bg-transparent', 'text-white/60');
      tabPhotos.classList.remove('bg-[#2A8B3C]', 'text-white');
      tabPhotos.classList.add('bg-transparent', 'text-white/60');
    }
  }
  
  tabPhotos?.addEventListener('click', () => showTab('photos'));
  tabVideos?.addEventListener('click', () => showTab('videos'));
  
  showTab('photos');

  // Lightbox functionality
  const lightbox = document.getElementById('lightbox');
  const lbImage = document.getElementById('lb-image');
  const lbVideo = document.getElementById('lb-video');
  const lbCaption = document.getElementById('lb-caption');
  const lbClose = document.getElementById('lb-close');
  const lbNext = document.getElementById('lb-next');
  const lbPrev = document.getElementById('lb-prev');

  const allItems = Array.from(galleryItems);
  
  function getVisibleIndices() {
    return allItems.reduce((acc, item, i) => {
      if (item.style.display !== 'none') acc.push(i);
      return acc;
    }, []);
  }
  
  let visibleIndices = getVisibleIndices();
  let currentIndexInVisible = 0;

  function openAt(i) {
    const item = allItems[i];
    if (!item || !lightbox) return;
    
    const type = item.getAttribute('data-type');
    const src = item.getAttribute('data-full-src') || '';
    const alt = item.getAttribute('data-alt') || '';
    
    if (lbImage) lbImage.classList.add('hidden');
    if (lbVideo) lbVideo.classList.add('hidden');
    
    if (type === 'video') {
      if (lbVideo) {
        lbVideo.src = src;
        lbVideo.classList.remove('hidden');
        lbVideo.play().catch(() => {});
      }
    } else {
      if (lbImage) {
        lbImage.src = src;
        lbImage.alt = alt;
        lbImage.classList.remove('hidden');
      }
    }
    
    if (lbCaption) lbCaption.textContent = alt;
    
    visibleIndices = getVisibleIndices();
    currentIndexInVisible = visibleIndices.indexOf(i);
    if (currentIndexInVisible < 0) currentIndexInVisible = 0;
    
    lightbox.classList.replace('hidden', 'flex');
    setTimeout(() => {
      lightbox.classList.add('opacity-100');
    }, 10);
  }

  function close() {
    if (!lightbox) return;
    if (lbVideo) {
      lbVideo.pause();
      lbVideo.src = '';
    }
    lightbox.classList.remove('opacity-100');
    setTimeout(() => {
      lightbox.classList.replace('flex', 'hidden');
    }, 300);
  }

  function next() {
    if (visibleIndices.length === 0) return;
    currentIndexInVisible = (currentIndexInVisible + 1) % visibleIndices.length;
    openAt(visibleIndices[currentIndexInVisible]);
  }

  function prev() {
    if (visibleIndices.length === 0) return;
    currentIndexInVisible = (currentIndexInVisible - 1 + visibleIndices.length) % visibleIndices.length;
    openAt(visibleIndices[currentIndexInVisible]);
  }

  allItems.forEach((item, i) => {
    item.addEventListener('click', () => openAt(i));
  });

  lbClose?.addEventListener('click', close);
  lbNext?.addEventListener('click', next);
  lbPrev?.addEventListener('click', prev);
  
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox && !lightbox.classList.contains('hidden')) {
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    }
  });
</script>
