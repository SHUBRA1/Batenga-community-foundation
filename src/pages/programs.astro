---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Programs — Batenga Community Foundation" activePage="programs">
  <main class="max-w-[1080px] mx-auto mt-28 px-4 pb-20">
    <!-- Hero Page Header -->
    <header class="text-center mb-16 animate-fade-up">
      <span class="text-[#38A84F] uppercase font-bold tracking-[0.2em] text-xs">Our Initiatives</span>
      <h1 class="font-serif text-3xl md:text-5xl font-black mt-3 text-white leading-tight">Programs Rooted in Community</h1>
      <div class="w-16 h-1 bg-[#2A8B3C] mx-auto mt-6 mb-6"></div>
      <p class="text-white/70 max-w-[760px] mx-auto text-sm md:text-base leading-relaxed">
        Every initiative we run addresses a specific, direct need felt by vulnerable families in rural and urban Uganda.
      </p>
    </header>

    <!-- Core Programs Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20 reveal">
      <!-- Card 1 -->
      <div class="bg-[#111] border border-white/5 border-t-[3px] border-t-[#2A8B3C] hover:border-t-[#38A84F] rounded-md p-8 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
            <i class="fas fa-house-chimney text-[#38A84F] text-xl"></i>
          </div>
          <h3 class="font-serif font-bold text-lg text-white mb-3">Housing Project</h3>
          <p class="text-white/60 text-xs md:text-sm leading-relaxed">
            Constructing brick-and-mortar homes valued at UGX 5 million (~USD 1,350) each for vulnerable widows and child-headed households. We have built 21 homes in Kyankwanzi and 19 in Buikwe.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-[#111] border border-white/5 border-t-[3px] border-t-[#2A8B3C] hover:border-t-[#38A84F] rounded-md p-8 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
            <i class="fas fa-graduation-cap text-[#38A84F] text-xl"></i>
          </div>
          <h3 class="font-serif font-bold text-lg text-white mb-3">Orphan Sponsorship</h3>
          <p class="text-white/60 text-xs md:text-sm leading-relaxed">
            Supporting orphaned children across Uganda with school fees, uniforms, materials, and mentoring. Over 40 children have received sponsorships to complete primary and secondary schooling.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-[#111] border border-white/5 border-t-[3px] border-t-[#2A8B3C] hover:border-t-[#38A84F] rounded-md p-8 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
            <i class="fas fa-stethoscope text-[#38A84F] text-xl"></i>
          </div>
          <h3 class="font-serif font-bold text-lg text-white mb-3">Health Camps</h3>
          <p class="text-white/60 text-xs md:text-sm leading-relaxed">
            Organizing direct-access health camps in rural neighborhoods to supply diagnosis, medication, consultations, and basic medical awareness to families located far from hospital facilities.
          </p>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-[#111] border border-white/5 border-t-[3px] border-t-[#2A8B3C] hover:border-t-[#38A84F] rounded-md p-8 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
            <i class="fas fa-droplet text-[#38A84F] text-xl"></i>
          </div>
          <h3 class="font-serif font-bold text-lg text-white mb-3">Water & Sanitation</h3>
          <p class="text-white/60 text-xs md:text-sm leading-relaxed">
            Drilling boreholes and establishing solar-managed local water pumps in rural areas experiencing severe water scarcity, providing thousands of residents with clean, safe drinking water.
          </p>
        </div>
      </div>

      <!-- Card 5 -->
      <div class="bg-[#111] border border-white/5 border-t-[3px] border-t-[#2A8B3C] hover:border-t-[#38A84F] rounded-md p-8 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
            <i class="fas fa-hand-holding-heart text-[#38A84F] text-xl"></i>
          </div>
          <h3 class="font-serif font-bold text-lg text-white mb-3">Food Relief</h3>
          <p class="text-white/60 text-xs md:text-sm leading-relaxed">
            Distributing relief food packages (containing rice, beans, maize flour, milk, sugar) to expectations mothers, local elderly residents, and highly disadvantaged families during hard economic cycles.
          </p>
        </div>
      </div>

      <!-- Card 6 -->
      <div class="bg-[#111] border border-white/5 border-t-[3px] border-t-[#2A8B3C] hover:border-t-[#38A84F] rounded-md p-8 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded bg-[#2A8B3C]/10 flex items-center justify-center mb-6">
            <i class="fas fa-people-group text-[#38A84F] text-xl"></i>
          </div>
          <h3 class="font-serif font-bold text-lg text-white mb-3">Community Outreach</h3>
          <p class="text-white/60 text-xs md:text-sm leading-relaxed">
            Carrying out civic training, basic technical skills development, and community sensitization to build individual competencies and support long-term localized economic development.
          </p>
        </div>
      </div>
    </section>

    <!-- Youth Arm (Konooweka Section) -->
    <section class="bg-gradient-to-br from-[#1A5C27] to-[#0f3d1a] border border-[#2A8B3C]/35 rounded-md p-8 md:p-12 reveal">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-[#F4C400] text-xs font-bold tracking-[0.2em] uppercase block mb-2">Youth Arm</span>
          <h2 class="font-serif font-black text-3xl md:text-4xl text-white leading-tight">Konooweka Youth Program</h2>
          <p class="text-white/80 text-sm md:text-base leading-relaxed mt-4">
            Konooweka is the youth arm of Batenga Community Foundation, channeling the energy, capacity, and creative talents of young people into localized social transformation, advocacy, and vocational skills development. The program was officially reinstated in January 2025 to scale its operations.
          </p>
          <div class="mt-6">
            <span class="inline-flex items-center gap-2 text-white/60 text-xs tracking-wider uppercase font-bold bg-black/20 px-4 py-2 rounded-full border border-white/5">
              <i class="fas fa-calendar-check text-[#F4C400]"></i>
              Reinstated January 21, 2025
            </span>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <p class="text-white/50 text-[10px] font-bold tracking-[0.15em] uppercase mb-1">Follow Konooweka channels</p>
          <a class="flex items-center gap-4 p-4 rounded bg-black/20 hover:bg-black/30 border border-white/5 hover:border-white/10 transition-all hover:translate-x-1" href="https://www.youtube.com/@konoowekayouthprogram2564" target="_blank" rel="noopener">
            <div class="w-10 h-10 rounded-full bg-[#FF0000] text-white flex items-center justify-center text-base"><i class="fab fa-youtube"></i></div>
            <div class="flex-1"><div class="text-white/50 text-[10px] tracking-wider uppercase">YouTube</div><div class="text-white font-semibold text-sm">@konoowekayouthprogram2564</div></div>
            <i class="fas fa-arrow-right text-white/20 text-xs"></i>
          </a>
          <a class="flex items-center gap-4 p-4 rounded bg-black/20 hover:bg-black/30 border border-white/5 hover:border-white/10 transition-all hover:translate-x-1" href="https://www.facebook.com/Konooweka" target="_blank" rel="noopener">
            <div class="w-10 h-10 rounded-full bg-[#1877F2] text-white flex items-center justify-center text-base"><i class="fab fa-facebook-f"></i></div>
            <div class="flex-1"><div class="text-white/50 text-[10px] tracking-wider uppercase">Facebook</div><div class="text-white font-semibold text-sm">Konooweka</div></div>
            <i class="fas fa-arrow-right text-white/20 text-xs"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Reveal transition style */
  :global(.reveal) {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.reveal.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>

<script>
  // Simple intersection observer for reveals
  const revealEls = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  revealEls.forEach((el) => obs.observe(el));
</script>
