---
---
<footer class="bg-[#040404] px-5 md:px-10 py-12 border-t border-[#F8F5F0]/10">
  <div class="max-w-[1080px] mx-auto flex items-center justify-between flex-wrap gap-6">
    <div class="flex items-center gap-3">
      <img src={`${import.meta.env.BASE_URL}logo.png`} alt="BCF Logo" class="h-9 w-auto" />
      <span class="font-serif text-[0.9rem] font-bold text-[#F8F5F0]/85">Batenga Community Foundation</span>
    </div>
    <div class="text-[0.78rem] text-[#F8F5F0]/35">
      &copy; {new Date().getFullYear()} Batenga Community Foundation &mdash; Founded 2015
    </div>
    <div class="flex gap-3">
      <a href="https://www.youtube.com/@konoowekayouthprogram2564" target="_blank" rel="noopener" aria-label="YouTube Channel" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[0.78rem] text-[#F8F5F0]/55 hover:bg-[#2A8B3C] hover:text-white transition-colors duration-250 no-underline">
        <i class="fab fa-youtube"></i>
      </a>
      <a href="https://www.facebook.com/Konooweka" target="_blank" rel="noopener" aria-label="Facebook Page" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[0.78rem] text-[#F8F5F0]/55 hover:bg-[#2A8B3C] hover:text-white transition-colors duration-250 no-underline">
        <i class="fab fa-facebook-f"></i>
      </a>
      <a href="https://x.com/BATENGAFO" target="_blank" rel="noopener" aria-label="X (formerly Twitter) Profile" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[0.78rem] text-[#F8F5F0]/55 hover:bg-[#2A8B3C] hover:text-white transition-colors duration-250 no-underline">
        <i class="fab fa-x-twitter"></i>
      </a>
      <a href="https://www.instagram.com/batengafoundation/" target="_blank" rel="noopener" aria-label="Instagram Profile" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[0.78rem] text-[#F8F5F0]/55 hover:bg-[#2A8B3C] hover:text-white transition-colors duration-250 no-underline">
        <i class="fab fa-instagram"></i>
      </a>
    </div>
  </div>
</footer>
